      "link": null,
      "locked": false,
      "text": "This diagram should serve as an initial guide to the implementation of this engine, but shouldn't restrict any design changes that I might have while coding, \nI'll try my best to update the diagram if I have any modification in the designs that might make this diagram wrong, but if I add something that might help \nimplement the InputSystem for example, I might not add it to this diagram, only if I feel like it's key piece of the engine design. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This diagram should serve as an initial guide to the implementation of this engine, but shouldn't restrict any design changes that I might have while coding, \nI'll try my best to update the diagram if I have any modification in the designs that might make this diagram wrong, but if I add something that might help \nimplement the InputSystem for example, I might not add it to this diagram, only if I feel like it's key piece of the engine design. ",
      "autoResize": true,
      "lineHeight": 1.25
    }
