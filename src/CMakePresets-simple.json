{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-simple",
      "displayName": "Windows x64 Simple",
      "description": "Simple Windows build without vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-vcpkg",
      "displayName": "Windows x64 with vcpkg",
      "description": "Windows build with vcpkg (requires VCPKG_ROOT environment variable)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{VCPKG_ROOT}",
        "rhs": ""
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-simple-build",
      "configurePreset": "windows-simple"
    },
    {
      "name": "windows-vcpkg-build",
      "configurePreset": "windows-vcpkg"
    }
  ]
}
